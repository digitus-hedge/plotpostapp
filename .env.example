# Copy to .env (local) or upload as .env next to server.js on Hostinger.
# Never commit .env or share real values.

# --- Already in your .env ---------------------------------------------------
# MySQL / MariaDB. On Hostinger: hPanel → Databases → MySQL Databases
# (the names look like u123456789_plotpost; the host is usually localhost).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=plotpost
# Long random string (keep just ONE JWT_SECRET line). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- New for Screen 1: Forgot Password emails --------------------------------
# Google Workspace / Gmail: turn on 2-Step Verification, then Google Account >
# Security > App passwords > create one. Use the full address as SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown in the email, e.g. PlotPost <you@yourdomain.com>
EMAIL_FROM=
# Testing on your PC without SMTP: print reset codes in the terminal instead.
# Never set this on Railway.
EMAIL_DEV_LOG_CODES=false

# --- New for Screen 1: Continue with Google ------------------------------------
# The "Web application" OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_IDS=

# --- New for Screen 1: login rate limit (optional) -----------------------------
# Max login / sign-up / reset requests per IP address per 15 minutes.
RATE_LIMIT_AUTH_MAX=20

# --- New for Screen 12: phone alerts (Firebase Cloud Messaging, free) --------
# Firebase console > Project settings > Service accounts > Generate new
# private key. Paste the whole file as one line, or its base64 (easier on
# Railway):  node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
# Leave empty to keep phone alerts off. Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: only if the project ID differs from the one in the key file.
FIREBASE_PROJECT_ID=

# --- Phase 4: security -------------------------------------------------------
# Websites allowed to call the API from a browser, comma-separated, e.g.
#   CORS_ORIGINS=https://plot-post.com,https://www.plot-post.com
# The Android app doesn't need to be listed. Empty: any site on your PC,
# none in production (the /admin panel always works).
CORS_ORIGINS=
# How many proxies sit in front of the server (Railway: 1, the default in
# production). Lets rate limits see each phone's real address.
TRUST_PROXY=
# Optional limits (defaults in brackets):
# reset / verification codes per email address per hour [5]
RATE_LIMIT_EMAIL_CODE_MAX=
# wrong passwords per account per 15 minutes [10]
RATE_LIMIT_LOGIN_FAIL_MAX=
# photo uploads per account per hour [60]
RATE_LIMIT_UPLOAD_MAX=
# new listings per account per day [30]
RATE_LIMIT_POST_MAX=
# likes, follows and saves per account per hour [300]
RATE_LIMIT_ACTION_MAX=

# --- Phase 4 Step 2: email (verification and reset codes) --------------------
# Railway's Hobby plan blocks SMTP, so use an email service with an HTTPS API.
# Brevo (free 300 emails/day): brevo.com > SMTP & API > API Keys > Generate.
BREVO_API_KEY=
# Or Resend (free 100/day): resend.com > API Keys.
RESEND_API_KEY=
# Only needed when more than one is set: brevo, resend or smtp.
EMAIL_PROVIDER=
# EMAIL_FROM above must be an address on a domain (or sender) you verified
# with that service, e.g.  PlotPost <no-reply@your-domain.com>
# New accounts confirm their email (6-digit code) before posting, sending
# interest, chatting or commenting. Set to false to switch that off.
EMAIL_VERIFICATION_REQUIRED=

# --- Phase 5: going live ------------------------------------------------------
# On Railway: production (switches on the production checks and turns off the
# Windows DNS fix). On your PC leave it out.
NODE_ENV=
# Where the admin panel is, for links in report emails, e.g.
#   ADMIN_PANEL_URL=https://api.your-domain.com/admin
ADMIN_PANEL_URL=
# Extra addresses that get an email for every new report (admins always do).
REPORT_ALERT_EMAILS=
# Who gets an email when the server has a problem (a server error or a
# crash; at most one email every 15 minutes). Empty: REPORT_ALERT_EMAILS.
ERROR_ALERT_EMAILS=
# (Backups: use hPanel → Databases → phpMyAdmin → Export, or Hostinger's
# automatic backups. The old `npm run backup` script is MongoDB-only.)
